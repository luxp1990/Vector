<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题 -->
    <SolidColorBrush x:Key="BgBrush"                Color="#F0F0F5"/>
    <SolidColorBrush x:Key="SurfaceBrush"           Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceLightBrush"      Color="#F8F8FC"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush"      Color="#ECECF2"/>
    <SolidColorBrush x:Key="BorderBrush"            Color="#DCDCE6"/>
    <SolidColorBrush x:Key="BorderLightBrush"       Color="#C8C8D8"/>
    <SolidColorBrush x:Key="PrimaryBrush"           Color="#3F51B5"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"      Color="#5C6BC0"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"       Color="#303F9F"/>
    <SolidColorBrush x:Key="TextBrush"               Color="#1E1E23"/>
    <SolidColorBrush x:Key="TextMutedBrush"         Color="#787887"/>
    <SolidColorBrush x:Key="TextFaintBrush"         Color="#6E6E80"/>
    <SolidColorBrush x:Key="SuccessBrush"            Color="#22C55E"/>
    <SolidColorBrush x:Key="DangerBrush"             Color="#EF4444"/>
    <SolidColorBrush x:Key="AccentBrush"             Color="#3F51B5"/>
    <SolidColorBrush x:Key="AccentSubtleBrush"      Color="#1E3F51B5"/>
    <SolidColorBrush x:Key="ListEvenBrush"           Color="#F8F8FC"/>
    <SolidColorBrush x:Key="ListOddBrush"            Color="#F0F0F5"/>
    <SolidColorBrush x:Key="ListSelectedBrush"       Color="#E0E0EC"/>
    <SolidColorBrush x:Key="OverlayBackdropBrush"    Color="#66181824"/>

</ResourceDictionary>