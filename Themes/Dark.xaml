<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题（默认） -->
    <SolidColorBrush x:Key="BgBrush"                Color="#121217"/>
    <SolidColorBrush x:Key="SurfaceBrush"           Color="#1C1C24"/>
    <SolidColorBrush x:Key="SurfaceLightBrush"      Color="#262630"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush"      Color="#2C2C38"/>
    <SolidColorBrush x:Key="BorderBrush"            Color="#373746"/>
    <SolidColorBrush x:Key="BorderLightBrush"       Color="#46465A"/>
    <SolidColorBrush x:Key="PrimaryBrush"           Color="#6366F1"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"      Color="#818CF8"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"       Color="#4F46E5"/>
    <SolidColorBrush x:Key="TextBrush"               Color="#F4F4F5"/>
    <SolidColorBrush x:Key="TextMutedBrush"         Color="#787887"/>
    <SolidColorBrush x:Key="TextFaintBrush"         Color="#88889A"/>
    <SolidColorBrush x:Key="SuccessBrush"            Color="#22C55E"/>
    <SolidColorBrush x:Key="DangerBrush"             Color="#EF4444"/>
    <SolidColorBrush x:Key="AccentBrush"             Color="#6366F1"/>
    <SolidColorBrush x:Key="AccentSubtleBrush"      Color="#1E6366F1"/>
    <SolidColorBrush x:Key="ListEvenBrush"           Color="#262630"/>
    <SolidColorBrush x:Key="ListOddBrush"            Color="#2C2C38"/>
    <SolidColorBrush x:Key="ListSelectedBrush"       Color="#373750"/>
    <SolidColorBrush x:Key="OverlayBackdropBrush"    Color="#9909090D"/>

</ResourceDictionary>