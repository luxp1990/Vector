<Window x:Class="Vector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vector"
        mc:Ignorable="d"
        Title="Vector"
        Height="680" Width="960"
        MinHeight="600" MinWidth="860"
        Icon="Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <!-- Ctrl+Z 撤销快捷键（窗口级别） -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="Z" Command="ApplicationCommands.Undo"/>
    </Window.InputBindings>

    <!-- Ctrl+Z 命令绑定到 Code-Behind 处理函数（避免引入完整 MVVM） -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Undo"
                        Executed="OnUndoExecuted"
                        CanExecute="OnUndoCanExecute"/>
    </Window.CommandBindings>

    <!-- 功能开关（滑动开关）样式：轨道 40x20，白色滑块，开启态用主色 -->
    <Window.Resources>
        <local:ShortcutTypeToDisplayConverter x:Key="ShortcutTypeToDisplayConverter"/>
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Track"
                                    CornerRadius="10"
                                    Background="{DynamicResource BorderBrush}"/>
                            <Border x:Name="Thumb"
                                    Width="16" Height="16"
                                    CornerRadius="8"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="2,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#6366F1"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#6366F1" BlurRadius="8" Opacity="0.5" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" PreviewMouseLeftButtonDown="RootGrid_PreviewMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             左侧边栏
             ============================================================ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Logo + 标题 -->
                    <RowDefinition Height="*"/>     <!-- 全局热键卡片 -->
                    <RowDefinition Height="Auto"/>   <!-- 导入/导出按钮 -->
                </Grid.RowDefinitions>

                <!-- Logo + 标题 + 副标题 -->
                <StackPanel Grid.Row="0" Margin="16,18,16,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <!-- 矢量三角形 Logo（Path 无限DPI清晰，与 WinForms 风格一致） -->
                        <Path Width="28" Height="28" Stretch="Uniform" Margin="0,0,10,0"
                              Data="M 2,3 L 30,3 L 16,29 Z"
                              VerticalAlignment="Center">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#818CF8" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <TextBlock Text="Vector"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Sidebar_Subtitle}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="40,0,0,0"/>
                </StackPanel>

                <!-- 全局热键设置卡片（带阴影圆角） -->
                <Border Grid.Row="1"
                        Margin="16,0,16,12"
                        Background="{DynamicResource SurfaceHoverBrush}"
                        CornerRadius="10"
                        Padding="14">
                    <Border.Effect>
                        <!-- 不依赖 Region，直接用 WPF DropShadow 实现完美圆角阴影 -->
                        <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.35" ShadowDepth="2" Direction="270"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Global_Section_Title}"
                                   TextWrapping="Wrap"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{DynamicResource Global_Section_Desc}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,2,0,12"/>

                        <!-- 全局热键输入框：未设置时为空，勿假显示默认组合 -->
                        <TextBox x:Name="TxtGlobalKey"
                                 Text=""
                                 ToolTip="{DynamicResource Global_Hotkey_Tooltip}"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="36"
                                 PreviewKeyDown="TxtGlobalKey_PreviewKeyDown"/>

                        <!-- 保存热键按钮 -->
                        <Button x:Name="BtnSetGlobal"
                                Content="{DynamicResource Global_SaveHotkey_Btn}"
                                Style="{StaticResource PrimaryButton}"
                                Height="36"
                                Margin="0,12,0,0"
                                Click="BtnSetGlobal_Click"/>

                        <!-- 功能开关：手动设置互相独立；全局热键临时暂停当前已启用功能 -->
                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="0,16,0,14"/>
                        <TextBlock Text="{DynamicResource Features_Section_Title}"
                                   TextWrapping="Wrap"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{DynamicResource Features_Section_Desc}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,2,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Features_Hotkeys_Label}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>
                            <ToggleButton x:Name="TglHotkeys"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="True"
                                          VerticalAlignment="Center"
                                          ToolTip="{DynamicResource Features_Hotkeys_Tooltip}"
                                          Checked="TglHotkeys_Changed"
                                          Unchecked="TglHotkeys_Changed"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Features_Pin_Label}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{DynamicResource Features_Pin_SubLabel}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <ToggleButton x:Name="TglPin"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="True"
                                          VerticalAlignment="Center"
                                          ToolTip="{DynamicResource Features_Pin_Tooltip}"
                                          Checked="TglPin_Changed"
                                          Unchecked="TglPin_Changed"/>
                        </Grid>
                        <CheckBox x:Name="ChkHotkeyDiagnostics"
                                  ToolTip="{DynamicResource Settings_Diagnostics_Tooltip}"
                                  Foreground="{DynamicResource TextMutedBrush}"
                                  FontSize="11"
                                  Margin="0,12,0,0"
                                  Checked="ChkHotkeyDiagnostics_Changed"
                                  Unchecked="ChkHotkeyDiagnostics_Changed">
                            <TextBlock Text="{DynamicResource Settings_Diagnostics_Label}" TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox x:Name="ChkHotkeyCoexistence"
                                  ToolTip="{DynamicResource Settings_Coexistence_Tooltip}"
                                  Foreground="{DynamicResource TextMutedBrush}"
                                  FontSize="11"
                                  Margin="0,8,0,0"
                                  Checked="ChkHotkeyCoexistence_Changed"
                                  Unchecked="ChkHotkeyCoexistence_Changed">
                            <TextBlock Text="{DynamicResource Settings_Coexistence_Label}" TextWrapping="Wrap"/>
                        </CheckBox>

                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="0,14,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_Language_Label}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="CboLanguage"
                                      Grid.Column="1"
                                      Width="96"
                                      Height="32"
                                      Style="{StaticResource ModernComboBox}"
                                      SelectionChanged="CboLanguage_SelectionChanged">
                                <ComboBoxItem Content="中文" Tag="zh-CN"/>
                                <ComboBoxItem Content="English" Tag="en-US"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 底部：自启延迟 + 导入 / 导出 -->
                <StackPanel Grid.Row="2" Margin="16,12,16,16">
                    <TextBlock Text="{DynamicResource Settings_StartupDelay_Label}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtStartupDelay"
                             Style="{StaticResource ModernTextBox}"
                             Height="36"
                             Text="0"
                             ToolTip="{DynamicResource Settings_StartupDelay_Tooltip}"
                             Margin="0,0,0,12"
                             LostFocus="TxtStartupDelay_LostFocus"/>
                    <Button x:Name="BtnImport"
                            Content="{DynamicResource Sidebar_Import_Btn}"
                            Style="{StaticResource SecondaryButton}"
                            Height="36"
                            Margin="0,0,0,8"
                            Click="BtnImport_Click"/>
                    <Button x:Name="BtnExport"
                            Content="{DynamicResource Sidebar_Export_Btn}"
                            Style="{StaticResource SecondaryButton}"
                            Height="36"
                            Margin="0,0,0,8"
                            Click="BtnExport_Click"/>
                    <Button x:Name="BtnPinSettings"
                            Content="{DynamicResource Sidebar_PinTool_Btn}"
                            Style="{StaticResource PrimaryButton}"
                            Height="36"
                            Click="BtnPinSettings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             右侧内容区
             ============================================================ -->
        <Grid Grid.Column="1" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 标题栏 -->
                <RowDefinition Height="Auto"/>   <!-- 添加卡片 -->
                <RowDefinition Height="*"/>      <!-- 列表卡片 -->
                <RowDefinition Height="Auto"/>   <!-- 状态栏 -->
            </Grid.RowDefinitions>

            <!-- 标题栏：标题 + 计数 + 撤销按钮 -->
            <Grid Grid.Row="0" Height="40" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{DynamicResource Main_Title}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="LblCount"
                           Grid.Column="1"
                           Text="{DynamicResource Main_Count_Initial}"
                           FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
                <!-- 撤销按钮（栈空时通过 IsEnabled 控制禁用态） -->
                <Button x:Name="BtnUndo"
                        Grid.Column="2"
                        Content="{DynamicResource Main_Undo_Btn}"
                        Style="{StaticResource SecondaryButton}"
                        Height="32"
                        Padding="12,4"
                        VerticalAlignment="Center"
                        Click="BtnUndo_Click"
                        ToolTip="{DynamicResource Main_Undo_Tooltip}"/>
            </Grid>

            <!-- 添加快捷键卡片 -->
            <Border x:Name="AddCardBorder" Grid.Row="1"
                    Background="{DynamicResource SurfaceLightBrush}"
                    CornerRadius="12"
                    Margin="0,0,0,16"
                    Padding="16,14">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="8" Opacity="0.25" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{DynamicResource AddCard_Title}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,16"/>

                    <!-- 输入行：快捷键 / 类型 / 目标 / 浏览 / 添加 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtLocalKey"
                                 Grid.Column="0"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="40"
                                 Margin="0,0,8,0"
                                 AllowDrop="True"
                                 PreviewKeyDown="TxtLocalKey_PreviewKeyDown"/>

                        <ComboBox x:Name="CboType"
                                  Grid.Column="1"
                                  MinWidth="96"
                                  Height="40"
                                  Margin="0,0,8,0"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectedIndex="0"
                                  SelectionChanged="CboType_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource Type_Program}" Tag="程序"/>
                            <ComboBoxItem Content="{DynamicResource Type_Folder}" Tag="文件夹"/>
                            <ComboBoxItem Content="{DynamicResource Type_Web}" Tag="网页"/>
                            <ComboBoxItem Content="{DynamicResource Type_File}" Tag="文件"/>
                        </ComboBox>

                        <TextBox x:Name="TxtTarget"
                                 Grid.Column="2"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="40"
                                 Margin="0,0,8,0"
                                 AllowDrop="True"
                                 ToolTip="{DynamicResource AddCard_Target_Tooltip}"
                                 PreviewDrop="TxtTarget_PreviewDrop"
                                 PreviewDragEnter="TxtTarget_PreviewDragEnter"
                                 PreviewDragLeave="TxtTarget_PreviewDragLeave"
                                 PreviewDragOver="TxtTarget_PreviewDragOver"
                                 LostFocus="TxtTarget_LostFocus"/>

                        <Button x:Name="BtnBrowse"
                                Grid.Column="3"
                                Content="…"
                                Style="{StaticResource IconButton}"
                                Height="40"
                                Margin="0,0,8,0"
                                Click="BtnBrowse_Click"/>

                        <Button x:Name="BtnAdd"
                                Grid.Column="4"
                                MinWidth="96"
                                Padding="12,0"
                                Content="{DynamicResource AddCard_Add_Btn}"
                                Style="{StaticResource PrimaryButton}"
                                Height="40"
                                Margin="0,0,8,0"
                                Click="BtnAdd_Click"/>

                        <Button x:Name="BtnCancelEdit"
                                Grid.Column="5"
                                MinWidth="80"
                                Padding="12,0"
                                Content="{DynamicResource AddCard_Cancel_Btn}"
                                Style="{StaticResource SecondaryButton}"
                                Height="40"
                                Visibility="Collapsed"
                                Click="BtnCancelEdit_Click"/>
                    </Grid>

                    <!-- 高级选项：参数 / 工作目录 / 运行策略（默认折叠） -->
                    <StackPanel Margin="0,8,0,0">
                        <Button x:Name="BtnToggleAdvanced"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="0,2"
                                Click="BtnToggleAdvanced_Click"
                                ToolTip="{DynamicResource AddCard_Advanced_Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblAdvancedArrow"
                                           Text="▸"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock x:Name="LblAdvancedTitle"
                                           Text="{DynamicResource AddCard_Advanced_Title}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Grid Margin="0,8,0,0"
                              x:Name="ExtraFieldsGrid"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtArguments"
                                     Grid.Column="0"
                                     Style="{StaticResource ModernTextBox}"
                                     Height="36"
                                     Margin="0,0,8,0"
                                     ToolTip="{DynamicResource AddCard_Args_Tooltip}"/>
                            <TextBox x:Name="TxtWorkingDir"
                                     Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     Height="36"
                                     Margin="0,0,8,0"
                                     ToolTip="{DynamicResource AddCard_WorkingDir_Tooltip}"
                                     AllowDrop="True"
                                     PreviewDrop="TxtWorkingDir_PreviewDrop"
                                     PreviewDragOver="TxtTarget_PreviewDragOver"/>
                            <ComboBox x:Name="CboRunStrategy"
                                      Grid.Column="2"
                                      Height="36"
                                      Style="{StaticResource ModernComboBox}"
                                      SelectedIndex="1"
                                      ToolTip="{DynamicResource AddCard_RunStrategy_Tooltip}">
                                <ComboBoxItem Content="{DynamicResource RunStrategy_New}" Tag="New"/>
                                <ComboBoxItem Content="{DynamicResource RunStrategy_Activate}" Tag="Activate"/>
                                <ComboBoxItem Content="{DynamicResource RunStrategy_Toggle}" Tag="Toggle"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="LblEditTip"
                               Text="{DynamicResource AddCard_EditTip}"
                               TextWrapping="Wrap"
                               FontSize="12" FontStyle="Italic"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,10,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- 列表卡片（OpacityMask 圆角 + 渐变顶条） -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceLightBrush}"
                    CornerRadius="12"
                    Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="8" Opacity="0.25" ShadowDepth="1"/>
                </Border.Effect>
                <!-- OpacityMask：VisualBrush 画圆角白底，内部超出的直角元素被 GPU 完美切圆 -->
                <Border.OpacityMask>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Border Background="White" CornerRadius="12"
                                    Width="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=ActualWidth}"
                                    Height="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=ActualHeight}"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.OpacityMask>

                <!-- 外层 Grid：渐变顶条 + 列表内容垂直排列 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>   <!-- 渐变装饰条 -->
                        <RowDefinition Height="*"/>  <!-- 列表内容 -->
                    </Grid.RowDefinitions>

                    <!-- 渐变装饰顶条 -->
                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#818CF8" Offset="0"/>
                                <GradientStop Color="#6366F1" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- 快捷键列表：ItemsControl + Grid（支持 * 填满剩余空间） -->
                    <ListView x:Name="LvShortcuts"
                              Grid.Row="1"
                              ItemsSource="{Binding LocalShortcuts}"
                              Background="Transparent"
                              BorderThickness="0"
                              AlternationCount="2"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionMode="Extended"
                              MouseDoubleClick="LvShortcuts_DoubleClick">

                        <!-- 列头区 -->
                        <ListView.Template>
                            <ControlTemplate TargetType="ListView">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!-- 列头 -->
                                    <Border Grid.Row="0"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="Auto" MinWidth="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{DynamicResource List_Header_Key}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Padding="16,0,0,0"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource List_Header_Type}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Stretch"
                                                       Padding="8,0,8,0"
                                                       Cursor="Hand"
                                                       MouseLeftButtonUp="HeaderType_Click"
                                                       Tag="type_header"
                                                       ToolTip="{DynamicResource List_Header_Type_Tooltip}"/>
                                            <TextBlock Grid.Column="2" Text="{DynamicResource List_Header_Target}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Padding="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <!-- 列表内容 -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="0">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Grid>
                            </ControlTemplate>
                        </ListView.Template>

                        <!-- ItemsPanel：VirtualizingStackPanel 自动纵向堆叠且支持虚拟化 -->
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <!-- 行样式：交替色 + Hover + Selected -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    MinHeight="44">
                                                <ContentPresenter Margin="0"
                                                                     VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- 交替行颜色：DataTrigger 绑定附加属性（ItemsControl.AlternationIndex） -->
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent},
                                                                      Path=(ItemsControl.AlternationIndex)}"
                                                             Value="0">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource ListEvenBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent},
                                                                      Path=(ItemsControl.AlternationIndex)}"
                                                             Value="1">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource ListOddBrush}"/>
                                                </DataTrigger>
                                                <!-- 选中 -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource ListSelectedBrush}"/>
                                                </Trigger>
                                                <!-- Hover -->
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsSelected" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource SurfaceHoverBrush}"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <!-- 数据模板 -->
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Key}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Padding="16,0,0,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Type, Converter={StaticResource ShortcutTypeToDisplayConverter}}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Padding="8,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Target}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Padding="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>

                    <!-- 空列表提示 -->
                    <TextBlock x:Name="LblEmptyHint"
                               Grid.Row="1"
                               Text="{DynamicResource List_EmptyHint}"
                               FontSize="13"
                               Foreground="{DynamicResource TextFaintBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,60,0,0"
                               IsHitTestVisible="False"
                               Visibility="Visible"/>
                </Grid>
            </Border>

            <!-- 状态栏 -->
            <Border Grid.Row="3"
                    Margin="0,16,0,0"
                    Padding="0,6,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="8" Height="8"
                                 Fill="{DynamicResource SuccessBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <TextBlock x:Name="LblStatus"
                                   Text="{DynamicResource Status_Listening}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{DynamicResource Status_Hint}"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
