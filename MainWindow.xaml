<Window x:Class="Vector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vector"
        mc:Ignorable="d"
        Title="Vector"
        Height="680" Width="960"
        MinHeight="600" MinWidth="860"
        Icon="Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <!-- Ctrl+Z 撤销快捷键（窗口级别） -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="Z" Command="ApplicationCommands.Undo"/>
    </Window.InputBindings>

    <!-- Ctrl+Z 命令绑定到 Code-Behind 处理函数（避免引入完整 MVVM） -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Undo"
                        Executed="OnUndoExecuted"
                        CanExecute="OnUndoCanExecute"/>
    </Window.CommandBindings>

    <!-- 功能开关（滑动开关）样式：轨道 40x20，白色滑块，开启态用主色 -->
    <Window.Resources>
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Track"
                                    CornerRadius="10"
                                    Background="{DynamicResource BorderBrush}"/>
                            <Border x:Name="Thumb"
                                    Width="16" Height="16"
                                    CornerRadius="8"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="2,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#6366F1"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#6366F1" BlurRadius="8" Opacity="0.5" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" PreviewMouseLeftButtonDown="RootGrid_PreviewMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             左侧边栏
             ============================================================ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Logo + 标题 -->
                    <RowDefinition Height="*"/>     <!-- 全局热键卡片 -->
                    <RowDefinition Height="Auto"/>   <!-- 导入/导出按钮 -->
                </Grid.RowDefinitions>

                <!-- Logo + 标题 + 副标题 -->
                <StackPanel Grid.Row="0" Margin="16,18,16,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <!-- 矢量三角形 Logo（Path 无限DPI清晰，与 WinForms 风格一致） -->
                        <Path Width="28" Height="28" Stretch="Uniform" Margin="0,0,10,0"
                              Data="M 2,3 L 30,3 L 16,29 Z"
                              VerticalAlignment="Center">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#818CF8" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <TextBlock Text="Vector"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="快捷键助手"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="40,0,0,0"/>
                </StackPanel>

                <!-- 全局热键设置卡片（带阴影圆角） -->
                <Border Grid.Row="1"
                        Margin="16,0,16,12"
                        Background="{DynamicResource SurfaceHoverBrush}"
                        CornerRadius="10"
                        Padding="14">
                    <Border.Effect>
                        <!-- 不依赖 Region，直接用 WPF DropShadow 实现完美圆角阴影 -->
                        <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.35" ShadowDepth="2" Direction="270"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                    <StackPanel>
                        <TextBlock Text="全局开关"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="临时暂停 / 恢复当前手动启用的功能（未设置则留空）"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,2,0,12"/>

                        <!-- 全局热键输入框：未设置时为空，勿假显示默认组合 -->
                        <TextBox x:Name="TxtGlobalKey"
                                 Text=""
                                 ToolTip="点击后按下组合键；留空并保存可关闭全局开关热键。手动关闭的功能不会被此键开启。"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="36"
                                 PreviewKeyDown="TxtGlobalKey_PreviewKeyDown"/>

                        <!-- 保存热键按钮 -->
                        <Button x:Name="BtnSetGlobal"
                                Content="保存热键"
                                Style="{StaticResource PrimaryButton}"
                                Height="36"
                                Margin="0,12,0,0"
                                Click="BtnSetGlobal_Click"/>

                        <!-- 功能开关：手动设置互相独立；全局热键临时暂停当前已启用功能 -->
                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="0,16,0,14"/>
                        <TextBlock Text="功能开关"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="可分别手动启用；全局开关热键临时暂停当前已启用功能"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,2,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="快捷键功能"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>
                            <ToggleButton x:Name="TglHotkeys"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="True"
                                          VerticalAlignment="Center"
                                          ToolTip="手动关闭后，全局开关热键不会重新开启此功能"
                                          Checked="TglHotkeys_Changed"
                                          Unchecked="TglHotkeys_Changed"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="截图功能"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="手势贴图与截图热键"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <ToggleButton x:Name="TglPin"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="True"
                                          VerticalAlignment="Center"
                                          ToolTip="手动关闭后，全局开关热键不会重新开启截图功能；已贴出的图片保留"
                                          Checked="TglPin_Changed"
                                          Unchecked="TglPin_Changed"/>
                        </Grid>
                        <CheckBox x:Name="ChkHotkeyDiagnostics"
                                  ToolTip="把热键注册、消息分发和目标启动过程记录到 Vector.log；默认关闭"
                                  Foreground="{DynamicResource TextMutedBrush}"
                                  FontSize="11"
                                  Margin="0,12,0,0"
                                  Checked="ChkHotkeyDiagnostics_Changed"
                                  Unchecked="ChkHotkeyDiagnostics_Changed">
                            <TextBlock Text="热键诊断模式（排查时开启）" TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox x:Name="ChkHotkeyCoexistence"
                                  Content="智能避让前台冲突键"
                                  ToolTip="微信/QQ/浏览器/Excel等前台激活时，自动临时让渡冲突热键（如Alt+S、Ctrl+1~9），切走立即恢复"
                                  Foreground="{DynamicResource TextMutedBrush}"
                                  FontSize="11"
                                  Margin="0,8,0,0"
                                  Checked="ChkHotkeyCoexistence_Changed"
                                  Unchecked="ChkHotkeyCoexistence_Changed"/>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 底部：自启延迟 + 导入 / 导出 -->
                <StackPanel Grid.Row="2" Margin="16,12,16,16">
                    <TextBlock Text="开机自启延迟（秒）"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtStartupDelay"
                             Style="{StaticResource ModernTextBox}"
                             Height="36"
                             Text="0"
                             ToolTip="仅「开机启动」生效；手动打开不等待。建议 0～30。"
                             Margin="0,0,0,12"
                             LostFocus="TxtStartupDelay_LostFocus"/>
                    <Button x:Name="BtnImport"
                            Content="导入配置"
                            Style="{StaticResource SecondaryButton}"
                            Height="36"
                            Margin="0,0,0,8"
                            Click="BtnImport_Click"/>
                    <Button x:Name="BtnExport"
                            Content="导出配置"
                            Style="{StaticResource SecondaryButton}"
                            Height="36"
                            Margin="0,0,0,8"
                            Click="BtnExport_Click"/>
                    <Button x:Name="BtnPinSettings"
                            Content="贴图工具"
                            Style="{StaticResource PrimaryButton}"
                            Height="36"
                            Click="BtnPinSettings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             右侧内容区
             ============================================================ -->
        <Grid Grid.Column="1" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 标题栏 -->
                <RowDefinition Height="Auto"/>   <!-- 添加卡片 -->
                <RowDefinition Height="*"/>      <!-- 列表卡片 -->
                <RowDefinition Height="Auto"/>   <!-- 状态栏 -->
            </Grid.RowDefinitions>

            <!-- 标题栏：标题 + 计数 + 撤销按钮 -->
            <Grid Grid.Row="0" Height="40" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="我的快捷键"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="LblCount"
                           Grid.Column="1"
                           Text="0 项"
                           FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
                <!-- 撤销按钮（栈空时通过 IsEnabled 控制禁用态） -->
                <Button x:Name="BtnUndo"
                        Grid.Column="2"
                        Content="↶ 撤销 (Ctrl+Z)"
                        Style="{StaticResource SecondaryButton}"
                        Height="32"
                        Padding="12,4"
                        VerticalAlignment="Center"
                        Click="BtnUndo_Click"
                        ToolTip="撤销上一步操作"/>
            </Grid>

            <!-- 添加快捷键卡片 -->
            <Border x:Name="AddCardBorder" Grid.Row="1"
                    Background="{DynamicResource SurfaceLightBrush}"
                    CornerRadius="12"
                    Margin="0,0,0,16"
                    Padding="16,14">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="8" Opacity="0.25" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="添加快捷键"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,16"/>

                    <!-- 输入行：快捷键 / 类型 / 目标 / 浏览 / 添加 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtLocalKey"
                                 Grid.Column="0"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="40"
                                 Margin="0,0,8,0"
                                 AllowDrop="True"
                                 PreviewKeyDown="TxtLocalKey_PreviewKeyDown"/>

                        <ComboBox x:Name="CboType"
                                  Grid.Column="1"
                                  Height="40"
                                  Margin="0,0,8,0"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectedIndex="0"
                                  SelectionChanged="CboType_SelectionChanged">
                            <ComboBoxItem Content="程序"/>
                            <ComboBoxItem Content="文件夹"/>
                            <ComboBoxItem Content="网页"/>
                            <ComboBoxItem Content="文件"/>
                        </ComboBox>

                        <TextBox x:Name="TxtTarget"
                                 Grid.Column="2"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="40"
                                 Margin="0,0,8,0"
                                 AllowDrop="True"
                                 ToolTip="目标路径或网址"
                                 PreviewDrop="TxtTarget_PreviewDrop"
                                 PreviewDragEnter="TxtTarget_PreviewDragEnter"
                                 PreviewDragLeave="TxtTarget_PreviewDragLeave"
                                 PreviewDragOver="TxtTarget_PreviewDragOver"
                                 LostFocus="TxtTarget_LostFocus"/>

                        <Button x:Name="BtnBrowse"
                                Grid.Column="3"
                                Content="…"
                                Style="{StaticResource IconButton}"
                                Height="40"
                                Margin="0,0,8,0"
                                Click="BtnBrowse_Click"/>

                        <Button x:Name="BtnAdd"
                                Grid.Column="4"
                                Content="+ 添加"
                                Style="{StaticResource PrimaryButton}"
                                Height="40"
                                Margin="0,0,8,0"
                                Click="BtnAdd_Click"/>

                        <Button x:Name="BtnCancelEdit"
                                Grid.Column="5"
                                Content="取消"
                                Style="{StaticResource SecondaryButton}"
                                Height="40"
                                Visibility="Collapsed"
                                Click="BtnCancelEdit_Click"/>
                    </Grid>

                    <!-- 高级选项：参数 / 工作目录 / 运行策略（默认折叠） -->
                    <StackPanel Margin="0,8,0,0">
                        <Button x:Name="BtnToggleAdvanced"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="0,2"
                                Click="BtnToggleAdvanced_Click"
                                ToolTip="命令行参数、工作目录、运行策略">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblAdvancedArrow"
                                           Text="▸"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock x:Name="LblAdvancedTitle"
                                           Text="高级选项"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Grid Margin="0,8,0,0"
                              x:Name="ExtraFieldsGrid"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtArguments"
                                     Grid.Column="0"
                                     Style="{StaticResource ModernTextBox}"
                                     Height="36"
                                     Margin="0,0,8,0"
                                     ToolTip="命令行参数（可选）"/>
                            <TextBox x:Name="TxtWorkingDir"
                                     Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     Height="36"
                                     Margin="0,0,8,0"
                                     ToolTip="工作目录（可选，默认程序所在目录）"
                                     AllowDrop="True"
                                     PreviewDrop="TxtWorkingDir_PreviewDrop"
                                     PreviewDragOver="TxtTarget_PreviewDragOver"/>
                            <ComboBox x:Name="CboRunStrategy"
                                      Grid.Column="2"
                                      Height="36"
                                      Style="{StaticResource ModernComboBox}"
                                      SelectedIndex="1"
                                      ToolTip="运行策略（仅程序）">
                                <ComboBoxItem Content="始终新开" Tag="New"/>
                                <ComboBoxItem Content="已开则前置" Tag="Activate"/>
                                <ComboBoxItem Content="切换显示" Tag="Toggle"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="LblEditTip"
                               Text="编辑模式：修改后点击「更新」保存，点击「取消」放弃"
                               FontSize="12" FontStyle="Italic"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,10,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- 列表卡片（OpacityMask 圆角 + 渐变顶条） -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceLightBrush}"
                    CornerRadius="12"
                    Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="8" Opacity="0.25" ShadowDepth="1"/>
                </Border.Effect>
                <!-- OpacityMask：VisualBrush 画圆角白底，内部超出的直角元素被 GPU 完美切圆 -->
                <Border.OpacityMask>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Border Background="White" CornerRadius="12"
                                    Width="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=ActualWidth}"
                                    Height="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=ActualHeight}"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.OpacityMask>

                <!-- 外层 Grid：渐变顶条 + 列表内容垂直排列 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>   <!-- 渐变装饰条 -->
                        <RowDefinition Height="*"/>  <!-- 列表内容 -->
                    </Grid.RowDefinitions>

                    <!-- 渐变装饰顶条 -->
                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#818CF8" Offset="0"/>
                                <GradientStop Color="#6366F1" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- 快捷键列表：ItemsControl + Grid（支持 * 填满剩余空间） -->
                    <ListView x:Name="LvShortcuts"
                              Grid.Row="1"
                              ItemsSource="{Binding LocalShortcuts}"
                              Background="Transparent"
                              BorderThickness="0"
                              AlternationCount="2"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionMode="Extended"
                              MouseDoubleClick="LvShortcuts_DoubleClick">

                        <!-- 列头区 -->
                        <ListView.Template>
                            <ControlTemplate TargetType="ListView">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!-- 列头 -->
                                    <Border Grid.Row="0"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="快捷键"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Padding="16,0,0,0"/>
                                            <TextBlock Grid.Column="1" Text="类型"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Stretch"
                                                       Padding="8,0,8,0"
                                                       Cursor="Hand"
                                                       MouseLeftButtonUp="HeaderType_Click"
                                                       Tag="type_header"
                                                       ToolTip="点击按类型排序（程序→文件夹→网页），再次点击恢复"/>
                                            <TextBlock Grid.Column="2" Text="目标"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Padding="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <!-- 列表内容 -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="0">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Grid>
                            </ControlTemplate>
                        </ListView.Template>

                        <!-- ItemsPanel：VirtualizingStackPanel 自动纵向堆叠且支持虚拟化 -->
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <!-- 行样式：交替色 + Hover + Selected -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    MinHeight="44">
                                                <ContentPresenter Margin="0"
                                                                     VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- 交替行颜色：DataTrigger 绑定附加属性（ItemsControl.AlternationIndex） -->
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent},
                                                                      Path=(ItemsControl.AlternationIndex)}"
                                                             Value="0">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource ListEvenBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent},
                                                                      Path=(ItemsControl.AlternationIndex)}"
                                                             Value="1">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource ListOddBrush}"/>
                                                </DataTrigger>
                                                <!-- 选中 -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource ListSelectedBrush}"/>
                                                </Trigger>
                                                <!-- Hover -->
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsSelected" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource SurfaceHoverBrush}"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <!-- 数据模板 -->
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Key}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Padding="16,0,0,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Type}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Padding="8,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Target}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Padding="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>

                    <!-- 空列表提示 -->
                    <TextBlock x:Name="LblEmptyHint"
                               Grid.Row="1"
                               Text="暂无快捷键，点击上方「添加」开始配置"
                               FontSize="13"
                               Foreground="{DynamicResource TextFaintBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,60,0,0"
                               IsHitTestVisible="False"
                               Visibility="Visible"/>
                </Grid>
            </Border>

            <!-- 状态栏 -->
            <Border Grid.Row="3"
                    Margin="0,16,0,0"
                    Padding="0,6,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="8" Height="8"
                                 Fill="{DynamicResource SuccessBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <TextBlock x:Name="LblStatus"
                                   Text="监听中"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="双击编辑 · 右键菜单删除"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
