<Window x:Class="Vector.Windows.PinSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Pin_Window_Title}"
        Width="460" Height="690"
        MinWidth="430" MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Path Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0"
                      Data="M 2,3 L 30,3 L 16,29 Z" Fill="#6366F1"/>
                <TextBlock Text="{DynamicResource Pin_Title}" Style="{StaticResource TitleText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{DynamicResource Pin_Subtitle}"
                       Style="{StaticResource SubtitleText}" TextWrapping="Wrap" Margin="34,4,0,18"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceLightBrush}"
                CornerRadius="12"
                Padding="18">
            <StackPanel>
                <CheckBox x:Name="ChkEnabled"
                          Foreground="{DynamicResource TextBrush}"
                          FontWeight="SemiBold"
                          Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource Pin_EnableGesture_Label}" TextWrapping="Wrap"/>
                </CheckBox>
                <CheckBox x:Name="ChkDrawTrace"
                          Foreground="{DynamicResource TextBrush}"
                          Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource Pin_DrawTrace_Label}" TextWrapping="Wrap"/>
                </CheckBox>
                <CheckBox x:Name="ChkCopyCaptureToClipboard"
                          Foreground="{DynamicResource TextBrush}"
                          Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource Pin_AutoCopy_Label}" TextWrapping="Wrap"/>
                </CheckBox>

                <TextBlock Text="{DynamicResource Pin_SnapshotHotkey_Label}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtSnapshotKey"
                         Style="{StaticResource ModernTextBox}"
                         Height="38"
                         PreviewKeyDown="Hotkey_PreviewKeyDown"/>

                <TextBlock Text="{DynamicResource Pin_ClipboardHotkey_Label}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,13,0,5"/>
                <TextBox x:Name="TxtClipboardKey"
                         Style="{StaticResource ModernTextBox}"
                         Height="38"
                         PreviewKeyDown="Hotkey_PreviewKeyDown"/>

                <TextBlock Text="{DynamicResource Pin_ToggleHotkey_Label}" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,13,0,5"/>
                <TextBox x:Name="TxtToggleKey"
                         Style="{StaticResource ModernTextBox}"
                         Height="38"
                         PreviewKeyDown="Hotkey_PreviewKeyDown"/>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Pin_Sensitivity_Label}" Style="{StaticResource SmallText}" TextWrapping="Wrap"/>
                        <Slider x:Name="SldSensitivity" Minimum="1" Maximum="100"
                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Pin_Opacity_Label}" Style="{StaticResource SmallText}" TextWrapping="Wrap"/>
                        <Slider x:Name="SldAlpha" Minimum="0.25" Maximum="1"
                                TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{DynamicResource Pin_CaptureNow_Btn}"
                            Style="{StaticResource SecondaryButton}" Height="36"
                            Click="Snapshot_Click"/>
                    <Button Grid.Column="2" Content="{DynamicResource Pin_FromClipboard_Btn}"
                            Style="{StaticResource SecondaryButton}" Height="36"
                            Click="Clipboard_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="96"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblError"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="{DynamicResource Pin_Cancel_Btn}"
                    Style="{StaticResource SecondaryButton}" Height="36"
                    Click="Cancel_Click"/>
            <Button Grid.Column="3" Content="{DynamicResource Pin_Save_Btn}"
                    Style="{StaticResource PrimaryButton}" Height="36"
                    Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
