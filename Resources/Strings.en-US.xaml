<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="Settings_Language_Label">Language</sys:String>
    <sys:String x:Key="Type_Program">Program</sys:String>
    <sys:String x:Key="Type_Folder">Folder</sys:String>
    <sys:String x:Key="Type_Web">Webpage</sys:String>
    <sys:String x:Key="Type_File">File</sys:String>

    <!-- MainWindow -->
    <sys:String x:Key="Sidebar_Subtitle">Shortcut Assistant</sys:String>
    <sys:String x:Key="Global_Section_Title">Global Toggle</sys:String>
    <sys:String x:Key="Global_Section_Desc">Temporarily pause or resume enabled features (leave blank to disable)</sys:String>
    <sys:String x:Key="Global_Hotkey_Tooltip">Click and press a key combo; save empty to disable. Manually disabled features won't be turned on.</sys:String>
    <sys:String x:Key="Global_SaveHotkey_Btn">Save Hotkey</sys:String>
    <sys:String x:Key="Features_Section_Title">Feature Toggles</sys:String>
    <sys:String x:Key="Features_Section_Desc">Toggle independently; global hotkey temporarily pauses active features</sys:String>
    <sys:String x:Key="Features_Hotkeys_Label">Hotkeys</sys:String>
    <sys:String x:Key="Features_Hotkeys_Tooltip">When turned off manually, the global hotkey will not re-enable it</sys:String>
    <sys:String x:Key="Features_Pin_Label">Screenshot &amp; Pin</sys:String>
    <sys:String x:Key="Features_Pin_SubLabel">Gesture pin &amp; capture hotkeys</sys:String>
    <sys:String x:Key="Features_Pin_Tooltip">When turned off manually, the global hotkey won't re-enable it; existing pins stay</sys:String>
    <sys:String x:Key="Settings_Diagnostics_Tooltip">Log hotkey registration, dispatch, and launch details to Vector.log (off by default)</sys:String>
    <sys:String x:Key="Settings_Diagnostics_Label">Hotkey diagnostics (for troubleshooting)</sys:String>
    <sys:String x:Key="Settings_Coexistence_Label">Smart foreground hotkey yield</sys:String>
    <sys:String x:Key="Settings_Coexistence_Tooltip">Temporarily yield conflicting hotkeys (e.g. Alt+S, Ctrl+1~9) when apps like WeChat/QQ/Browser/Excel are active</sys:String>
    <sys:String x:Key="Settings_StartupDelay_Label">Startup delay (seconds)</sys:String>
    <sys:String x:Key="Settings_StartupDelay_Tooltip">Applies to Windows startup only; manual launch starts immediately. Recommended: 0–30.</sys:String>
    <sys:String x:Key="Sidebar_Import_Btn">Import Config</sys:String>
    <sys:String x:Key="Sidebar_Export_Btn">Export Config</sys:String>
    <sys:String x:Key="Sidebar_PinTool_Btn">Pin Tool</sys:String>
    <sys:String x:Key="Main_Title">My Shortcuts</sys:String>
    <sys:String x:Key="Main_Count_Initial">0 items</sys:String>
    <sys:String x:Key="Main_Undo_Btn">↶ Undo (Ctrl+Z)</sys:String>
    <sys:String x:Key="Main_Undo_Tooltip">Undo last action</sys:String>
    <sys:String x:Key="AddCard_Title">Add Shortcut</sys:String>
    <sys:String x:Key="AddCard_Target_Tooltip">Target path or URL</sys:String>
    <sys:String x:Key="AddCard_Add_Btn">+ Add</sys:String>
    <sys:String x:Key="AddCard_Cancel_Btn">Cancel</sys:String>
    <sys:String x:Key="AddCard_Advanced_Tooltip">Command-line arguments, working directory, run policy</sys:String>
    <sys:String x:Key="AddCard_Advanced_Title">Advanced Options</sys:String>
    <sys:String x:Key="AddCard_Args_Tooltip">Command-line arguments (optional)</sys:String>
    <sys:String x:Key="AddCard_WorkingDir_Tooltip">Working directory (optional, defaults to app folder)</sys:String>
    <sys:String x:Key="AddCard_RunStrategy_Tooltip">Run policy (programs only)</sys:String>
    <sys:String x:Key="RunStrategy_New">Always New</sys:String>
    <sys:String x:Key="RunStrategy_Activate">Bring to Front</sys:String>
    <sys:String x:Key="RunStrategy_Toggle">Toggle Show</sys:String>
    <sys:String x:Key="AddCard_EditTip">Edit mode: click "Update" to save changes, or "Cancel" to discard</sys:String>
    <sys:String x:Key="List_Header_Key">Hotkey</sys:String>
    <sys:String x:Key="List_Header_Type">Type</sys:String>
    <sys:String x:Key="List_Header_Type_Tooltip">Click to sort by type (Program → Folder → Webpage); click again to reset</sys:String>
    <sys:String x:Key="List_Header_Target">Target</sys:String>
    <sys:String x:Key="List_EmptyHint">No shortcuts yet. Click "+ Add" above to get started.</sys:String>
    <sys:String x:Key="Status_Listening">Listening</sys:String>
    <sys:String x:Key="Status_Hint">Double-click to edit · Right-click to delete</sys:String>

    <!-- PinSettingsWindow -->
    <sys:String x:Key="Pin_Window_Title">Vector · Pin Tool</sys:String>
    <sys:String x:Key="Pin_Title">Pin Tool</sys:String>
    <sys:String x:Key="Pin_Subtitle">Right-drag to capture and pin, or use global hotkeys</sys:String>
    <sys:String x:Key="Pin_EnableGesture_Label">Enable gestures &amp; pinning</sys:String>
    <sys:String x:Key="Pin_DrawTrace_Label">Show gesture trail</sys:String>
    <sys:String x:Key="Pin_AutoCopy_Label">Auto-copy capture to clipboard (off by default)</sys:String>
    <sys:String x:Key="Pin_SnapshotHotkey_Label">Region capture hotkey</sys:String>
    <sys:String x:Key="Pin_ClipboardHotkey_Label">Clipboard pin hotkey</sys:String>
    <sys:String x:Key="Pin_ToggleHotkey_Label">Pin toggle hotkey (optional, leave blank to disable)</sys:String>
    <sys:String x:Key="Pin_Sensitivity_Label">Gesture tolerance</sys:String>
    <sys:String x:Key="Pin_Opacity_Label">Pin opacity</sys:String>
    <sys:String x:Key="Pin_CaptureNow_Btn">Capture Now</sys:String>
    <sys:String x:Key="Pin_FromClipboard_Btn">Pin Clipboard</sys:String>
    <sys:String x:Key="Pin_Cancel_Btn">Cancel</sys:String>
    <sys:String x:Key="Pin_Save_Btn">Save</sys:String>
</ResourceDictionary>
