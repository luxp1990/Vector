<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="Settings_Language_Label">语言</sys:String>
    <sys:String x:Key="Type_Program">程序</sys:String>
    <sys:String x:Key="Type_Folder">文件夹</sys:String>
    <sys:String x:Key="Type_Web">网页</sys:String>
    <sys:String x:Key="Type_File">文件</sys:String>

    <!-- MainWindow -->
    <sys:String x:Key="Sidebar_Subtitle">快捷键助手</sys:String>
    <sys:String x:Key="Global_Section_Title">全局开关</sys:String>
    <sys:String x:Key="Global_Section_Desc">临时暂停 / 恢复当前手动启用的功能（未设置则留空）</sys:String>
    <sys:String x:Key="Global_Hotkey_Tooltip">点击后按下组合键；留空并保存可关闭全局开关热键。手动关闭的功能不会被此键开启。</sys:String>
    <sys:String x:Key="Global_SaveHotkey_Btn">保存热键</sys:String>
    <sys:String x:Key="Features_Section_Title">功能开关</sys:String>
    <sys:String x:Key="Features_Section_Desc">可分别手动启用；全局开关热键临时暂停当前已启用功能</sys:String>
    <sys:String x:Key="Features_Hotkeys_Label">快捷键功能</sys:String>
    <sys:String x:Key="Features_Hotkeys_Tooltip">手动关闭后，全局开关热键不会重新开启此功能</sys:String>
    <sys:String x:Key="Features_Pin_Label">截图功能</sys:String>
    <sys:String x:Key="Features_Pin_SubLabel">手势贴图与截图热键</sys:String>
    <sys:String x:Key="Features_Pin_Tooltip">手动关闭后，全局开关热键不会重新开启截图功能；已贴出的图片保留</sys:String>
    <sys:String x:Key="Settings_Diagnostics_Tooltip">把热键注册、消息分发和目标启动过程记录到 Vector.log；默认关闭</sys:String>
    <sys:String x:Key="Settings_Diagnostics_Label">热键诊断模式（排查时开启）</sys:String>
    <sys:String x:Key="Settings_Coexistence_Label">智能避让前台冲突键</sys:String>
    <sys:String x:Key="Settings_Coexistence_Tooltip">微信/QQ/浏览器/Excel等前台激活时，自动临时让渡冲突热键（如Alt+S、Ctrl+1~9），切走立即恢复</sys:String>
    <sys:String x:Key="Settings_StartupDelay_Label">开机自启延迟（秒）</sys:String>
    <sys:String x:Key="Settings_StartupDelay_Tooltip">仅「开机启动」生效；手动打开不等待。建议 0～30。</sys:String>
    <sys:String x:Key="Sidebar_Import_Btn">导入配置</sys:String>
    <sys:String x:Key="Sidebar_Export_Btn">导出配置</sys:String>
    <sys:String x:Key="Sidebar_PinTool_Btn">贴图工具</sys:String>
    <sys:String x:Key="Main_Title">我的快捷键</sys:String>
    <sys:String x:Key="Main_Count_Initial">0 项</sys:String>
    <sys:String x:Key="Main_Undo_Btn">↶ 撤销 (Ctrl+Z)</sys:String>
    <sys:String x:Key="Main_Undo_Tooltip">撤销上一步操作</sys:String>
    <sys:String x:Key="AddCard_Title">添加快捷键</sys:String>
    <sys:String x:Key="AddCard_Target_Tooltip">目标路径或网址</sys:String>
    <sys:String x:Key="AddCard_Add_Btn">+ 添加</sys:String>
    <sys:String x:Key="AddCard_Cancel_Btn">取消</sys:String>
    <sys:String x:Key="AddCard_Advanced_Tooltip">命令行参数、工作目录、运行策略</sys:String>
    <sys:String x:Key="AddCard_Advanced_Title">高级选项</sys:String>
    <sys:String x:Key="AddCard_Args_Tooltip">命令行参数（可选）</sys:String>
    <sys:String x:Key="AddCard_WorkingDir_Tooltip">工作目录（可选，默认程序所在目录）</sys:String>
    <sys:String x:Key="AddCard_RunStrategy_Tooltip">运行策略（仅程序）</sys:String>
    <sys:String x:Key="RunStrategy_New">始终新开</sys:String>
    <sys:String x:Key="RunStrategy_Activate">已开则前置</sys:String>
    <sys:String x:Key="RunStrategy_Toggle">切换显示</sys:String>
    <sys:String x:Key="AddCard_EditTip">编辑模式：修改后点击「更新」保存，点击「取消」放弃</sys:String>
    <sys:String x:Key="List_Header_Key">快捷键</sys:String>
    <sys:String x:Key="List_Header_Type">类型</sys:String>
    <sys:String x:Key="List_Header_Type_Tooltip">点击按类型排序（程序→文件夹→网页），再次点击恢复</sys:String>
    <sys:String x:Key="List_Header_Target">目标</sys:String>
    <sys:String x:Key="List_EmptyHint">暂无快捷键，点击上方「添加」开始配置</sys:String>
    <sys:String x:Key="Status_Listening">监听中</sys:String>
    <sys:String x:Key="Status_Hint">双击编辑 · 右键菜单删除</sys:String>

    <!-- PinSettingsWindow -->
    <sys:String x:Key="Pin_Window_Title">Vector · 贴图工具</sys:String>
    <sys:String x:Key="Pin_Title">贴图工具</sys:String>
    <sys:String x:Key="Pin_Subtitle">右键画框直接贴图，也可使用全局快捷键</sys:String>
    <sys:String x:Key="Pin_EnableGesture_Label">启用手势与贴图</sys:String>
    <sys:String x:Key="Pin_DrawTrace_Label">显示手势轨迹</sys:String>
    <sys:String x:Key="Pin_AutoCopy_Label">截图后自动复制到剪贴板（默认关闭）</sys:String>
    <sys:String x:Key="Pin_SnapshotHotkey_Label">框选贴图快捷键</sys:String>
    <sys:String x:Key="Pin_ClipboardHotkey_Label">剪贴板贴图快捷键</sys:String>
    <sys:String x:Key="Pin_ToggleHotkey_Label">贴图开关快捷键（可选，留空不启用）</sys:String>
    <sys:String x:Key="Pin_Sensitivity_Label">手势容错</sys:String>
    <sys:String x:Key="Pin_Opacity_Label">贴图透明度</sys:String>
    <sys:String x:Key="Pin_CaptureNow_Btn">立即框选</sys:String>
    <sys:String x:Key="Pin_FromClipboard_Btn">剪贴板贴图</sys:String>
    <sys:String x:Key="Pin_Cancel_Btn">取消</sys:String>
    <sys:String x:Key="Pin_Save_Btn">保存</sys:String>
</ResourceDictionary>
